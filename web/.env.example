# Copy to .env.local — do not commit .env.local

# Operations API base URL (empty = same origin + Vite dev proxy to backend)
VITE_API_BASE_URL=

# Firebase web app configuration (Firebase Console → Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Auth emulator for local development
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Auto refresh interval for read-only views (milliseconds)
VITE_OPERATIONS_REFRESH_MS=45000
