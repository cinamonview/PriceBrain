# Copy to .env — do not commit .env (project.mdc §13)

# --- Local development (optional Firestore Emulator) ---
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-pricebrain

# --- Local / CI with real Firestore credentials file ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Production (Cloud Run) ---
# Do NOT set FIRESTORE_EMULATOR_HOST in production.
# FIREBASE_PROJECT_ID=<production-firebase-project-id>
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase/service-account.json
#   (mount via Secret Manager volume; do not bake JSON into the image)
# PORT is injected by Cloud Run automatically.

# --- Ingest API (server-to-server; required for POST /internal/ingest/listing) ---
# Production: inject via Secret Manager → Cloud Run env (do not bake into image)
PRICEBRAIN_INGEST_API_URL=http://127.0.0.1:8000
PRICEBRAIN_INGEST_API_KEY=

# --- Crawler worker (local / Cloud Run job entrypoint) ---
PRICEBRAIN_CRAWLER_WORKER_ENABLED=true
PRICEBRAIN_CRAWLER_POLL_INTERVAL_SECONDS=60
PRICEBRAIN_CRAWLER_MAX_TARGETS_PER_CYCLE=10
PRICEBRAIN_CRAWLER_LEASE_SECONDS=300

# --- Crawler HTTP policy ---
PRICEBRAIN_CRAWLER_TIMEOUT_SECONDS=15
PRICEBRAIN_CRAWLER_MAX_RETRIES=2
PRICEBRAIN_CRAWLER_BACKOFF_SECONDS=1
PRICEBRAIN_CRAWLER_REQUEST_INTERVAL_SECONDS=0

# --- Optional (Phase 2+) ---
AI_API_KEY=

# --- Notifications (adapter layer only; no external API wired yet) ---
PRICEBRAIN_NOTIFICATION_ENABLED=false
PRICEBRAIN_NOTIFICATION_DEFAULT_CHANNEL=console
